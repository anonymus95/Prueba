      "metadata": {
        "id": "inicializacion-interfaz"
      },
      "source": [
        "import re\n",
        "import unicodedata\n",
        "import pandas as pd\n",
        "import io\n",
        "import ipywidgets as widgets\n",
        "from IPython.display import display, clear_output\n",
        "import base64\n",
        "\n",
        "def normalizar_caracteres_especiales(texto):\n",
        "    if not isinstance(texto, str):\n",
        "        return \"\"\n",
        "    \n",
        "    # Protección especial para conservar la Ñ y ñ antes de remover diacríticos\n",
        "    texto_protegido = texto.replace('Ñ', '[[MAY_N_TILDE]]').replace('ñ', '[[MIN_N_TILDE]]')\n",
        "    \n",
        "    # Reemplazar caracteres residuales comunes de codificación\n",
        "    texto_protegido = re.sub(r'[Ââ]', lambda m: 'A' if m.group().isupper() else 'a', texto_protegido)\n",
        "    \n",
        "    # Descomponer caracteres Unicode para separar las tildes/diacríticos de su letra base\n",
        "    nfkd_form = unicodedata.normalize('NFKD', texto_protegido)\n",
        "    \n",
        "    # Filtrar marcas de combinación (diacríticos), manteniendo el texto base\n",
        "    texto_sin_diacriticos = \"\".join([c for c in nfkd_form if not unicodedata.combining(c)])\n",
        "    \n",
        "    # Restaurar la Ñ y ñ originales\n",
        "    texto_restaurado = texto_sin_diacriticos.replace('[[MAY_N_TILDE]]', 'Ñ').replace('[[MIN_N_TILDE]]', 'ñ')\n",
        "    \n",
        "    return texto_restaurado\n",
        "\n",
        "def normalizar_direccion(direccion):\n",
        "    if pd.isna(direccion) or not str(direccion).strip():\n",
        "        return \"\"\n",
        "    \n",
        "    # Asegurar que el valor se trate como texto para no perder ceros a la izquierda ni formatearlo como decimal\n",
        "    texto = str(direccion)\n",
        "    \n",
        "    # 1. Tratamiento de espacios (reemplazar tabulaciones, NBSP y cualquier espacio Unicode por espacio normal ASCII)\n",
        "    texto_espacios = re.sub(r'\\s+', ' ', texto, flags=re.UNICODE)\n",
        "    \n",
        "    # 2. Normalización de letras con caracteres especiales (tildes, diacríticos, codificaciones extrañas)\n",
        "    texto_normalizado = normalizar_caracteres_especiales(texto_espacios)\n",
        "    \n",
        "    # 3. Filtrar y REEMPLAZAR por espacio los caracteres no permitidos:\n",
        "    patron_no_permitidos = re.compile(r'[^A-Za-zÑñ0-9 #\\-]')\n",
        "    texto_filtrado = patron_no_permitidos.sub(' ', texto_normalizado)\n",
        "    \n",
        "    # 4. Segunda pasada de control de espacios para asegurar consistencia\n",
        "    texto_final = re.sub(r' {2,}', ' ', texto_filtrado) # Reducir múltiples espacios a uno solo\n",
        "    texto_final = texto_final.strip() # Quitar espacios al inicio y al final\n",
        "    \n",
        "    return texto_final\n",
        "\n",
        "# Componentes de la interfaz gráfica\n",
        "uploader = widgets.FileUpload(accept='.xlsx', multiple=False, description=\"Buscar Excel\")\n",
        "btn_procesar = widgets.Button(description=\"Procesar y Generar\", button_style='success', icon='gear')\n",
        "output_area = widgets.Output()\n",
        "\n",
        "def ejecutar_normalizacion(b):\n",
        "    with output_area:\n",
        "        clear_output()\n",
        "        if not uploader.value:\n",
        "            print(\"❌ Por favor, primero selecciona un archivo Excel (.xlsx).\")\n",
        "            return\n",
        "        \n",
        "        print(\"⏳ Leyendo y procesando el archivo, por favor espera...\")\n",
        "        \n",
        "        try:\n",
        "            # Extraer correctamente el archivo adaptado a ipywidgets moderno\n",
        "            uploaded_file = uploader.value if isinstance(uploader.value, tuple) else list(uploader.value.values())\n",
        "            if isinstance(uploaded_file, list) or isinstance(uploaded_file, tuple):\n",
        "                uploaded_file = uploaded_file[0]\n",
        "                \n",
        "            nombre_archivo_original = uploaded_file['name'] if 'name' in uploaded_file else uploaded_file['metadata']['name']\n",
        "            contenido_archivo = uploaded_file['content']\n",
        "            \n",
        "            contenido_bytes = bytes(contenido_archivo)\n",
        "            df = pd.read_excel(io.BytesIO(contenido_bytes), dtype=str, engine='openpyxl')\n",
        "        except Exception as e:\n",
        "            print(f\"❌ Error al abrir el Excel: {e}\")\n",
        "            return\n",
        "\n",
        "        columna_objetivo = 'Direccion'\n",
        "        if columna_objetivo not in df.columns:\n",
        "            print(f\"❌ [ERROR] No se encontró la columna exacta '{columna_objetivo}' en el archivo Excel.\")\n",
        "            print(f\"Columnas detectadas: {list(df.columns)}\")\n",
        "            return\n",
        "\n",
        "        # Aplicar tu nueva normalización mejorada fila por fila\n",
        "        df['Direccion ajustada'] = df[columna_objetivo].apply(normalizar_direccion)\n",
        "        \n",
        "        # Calcular estadísticas de procesamiento exactas de tu versión\n",
        "        total_registros = len(df)\n",
        "        direcciones_vacias = df[columna_objetivo].apply(lambda x: pd.isna(x) or str(x).strip() == \"\").sum()\n",
        "        \n",
        "        mismas_direcciones = 0\n",
        "        modificadas_direcciones = 0\n",
        "        \n",
        "        for idx, fila in df.iterrows():\n",
        "            orig = str(fila[columna_objetivo]).strip() if not pd.isna(fila[columna_objetivo]) else \"\"\n",
        "            ajust = fila['Direccion ajustada']\n",
        "            if orig == \"\" and ajust == \"\":\n",
        "                continue\n",
        "            if orig == ajust:\n",
        "                mismas_direcciones += 1\n",
        "            else:\n",
        "                modificadas_direcciones += 1\n("\n",
        "        \n",
        "        # Preparar descarga segura\n",
        "        nombre_archivo_generado = nombre_archivo_original.replace(\".xlsx\", \"_ajustado.xlsx\")\n",
        "        if nombre_archivo_generado == nombre_archivo_original:\n",
        "            nombre_archivo_generado = \"direcciones_ajustadas.xlsx\"\n",
        "            \n",
        "        # Guardar en memoria para codificación Base64 inmediata\n",
        "        output_stream = io.BytesIO()\n",
        "        with pd.ExcelWriter(output_stream, engine='openpyxl') as writer:\n",
        "            df.to_excel(writer, index=False)\n",
        "        output_stream.seek(0)\n",
        "        \n",
        "        bytes_data = output_stream.read()\n",
        "        b64 = base64.b64encode(bytes_data).decode()\n",
        "        \n",
        "        clear_output()\n",
        "        \n",
        "        # Mostrar tus estadísticas formateadas en la pantalla\n",
        "        print(\"=\"*45)\n",
        "        print(\"          ESTADÍSTICAS DEL PROCESO\")\n",
        "        print(\"=\"*45)\n",
        "        print(f\"Nombre del archivo original:  {nombre_archivo_original}\")\n",
        "        print(f\"Cantidad total de registros:  {total_registros}\")\n",
        "        print(f\"Direcciones modificadas:      {modificadas_direcciones}\")\n",
        "        print(f\"Direcciones sin cambios:      {mismas_direcciones}\")\n",
        "        print(f\"Direcciones vacías o nulas:   {direcciones_vacias}\")\n",
        "        print(f\"Nombre del archivo generado:  {nombre_archivo_generado}\")\n",
        "        print(\"=\"*45 + \"\\n\")\n",
        "        \n",
        "        # Generar botón visual de descarga web nativa\n",
        "        href = f'<a href=\"data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,{b64}\" download=\"{nombre_archivo_generado}\" style=\"display: inline-block; padding: 12px 24px; background-color: #17a2b8; color: white; text-decoration: none; border-radius: 4px; font-weight: bold; font-family: Arial, sans-serif;\">⬇️ Descargar Resultado Excel</a>'\n",
        "        \n",
        "        print(\"¡Proceso completado! Haz clic aquí abajo para bajar tu archivo:\")\n",
        "        display(widgets.HTML(href))\n",
        "\n",
        "btn_procesar.on_click(ejecutar_normalizacion)\n",
        "\n",
        "# Maquetación visual de la App Web\n",
        "titulo = widgets.HTML(\"<h2>Normalizador de Direcciones - Luker</h2>\")\n",
        "instrucciones = widgets.HTML(\"<p>1. Selecciona tu archivo Excel (.xlsx)<br>2. Presiona 'Procesar y Generar' para limpiar las direcciones.</p>\")\n",
        "interfaz = widgets.VBox([titulo, instrucciones, uploader, widgets.HTML(\"<br>\"), btn_procesar, widgets.HTML(\"<br>\"), output_area])\n",
        "display(interfaz)\n"
      ],
      "execution_count": null,
      "outputs": []
    }
  ],
